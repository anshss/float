# Float MCP server config. Copy to .env and fill in what you have — every key
# here is optional. Missing keys degrade the layer that needs them to a
# structured denial at call time; the server still boots and serves with none
# of these set. Never commit .env.

# --- C2: The Graph (perception) ---
GRAPH_API_KEY=

# --- C3/C4/C6: Hedera (policy budgets, HCS audit log, treasury) ---
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TREASURY_ID=
HEDERA_TREASURY_KEY=
HEDERA_TOPIC_ID=
# Mirror Node REST base URL that spend_history reads HCS receipts from.
# Defaults to the public testnet mirror node when unset.
HEDERA_MIRROR_NODE_URL=

# --- C5: Privy (Arc hot server wallet; the Arc key itself never lives here) ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=

# --- C6: Ledger Wallet CLI (treasury custody) ---
LEDGER_CLI_BIN=

# --- Rails, always on ---
# Spending ceilings, read by the policy layer.
FLOAT_CAP_DEFAULT_USD=50
FLOAT_CAP_HOT_BALANCE_USD=200
# 1/true stubs every chain write and returns a synthetic dry_run:true tx id.
# Defaults to true whenever a write layer's creds above are missing.
DRY_RUN=1
