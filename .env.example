# Float MCP server config. Copy to .env and fill in what you have — every key
# here is optional. Missing keys degrade the layer that needs them to a
# structured denial at call time; the server still boots and serves with none
# of these set. Never commit .env.

# --- C2: The Graph (perception) ---
GRAPH_API_KEY=

# --- C3/C4/C6: Hedera (policy budgets, HCS audit log, treasury) ---
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TREASURY_ID=
HEDERA_TREASURY_KEY=
HEDERA_TOPIC_ID=
# Mirror Node REST base URL that spend_history reads HCS receipts from.
# Defaults to the public testnet mirror node when unset.
HEDERA_MIRROR_NODE_URL=
# Absolute path the policy layer persists minted treasury/spender/topic ids
# and keys to (never commit this directory). Only needed if auto-detection
# is insufficient: a linked worktree already resolves this to the main
# checkout's own layers/policy/.state/ on its own, with no env var required
# (#16) — a treasury minted inside a worktree that later gets `worktree:rm`'d
# otherwise loses its key permanently.
FLOAT_STATE_DIR=

# --- C4: payments (x402 on Hedera via Blocky402) ---
# Blocky402 facilitator base URL. Defaults to the public testnet facilitator.
BLOCKY402_API_BASE=
# payTo for our own gated resource server. Defaults to HEDERA_TREASURY_ID,
# then HEDERA_OPERATOR_ID, if unset — the gated service is Float's own, so
# there is nothing external to fund for the demo.
FLOAT_PAYTO_ID=
# Port the gated resource server listens on (see src/index.ts). Default 4402.
FLOAT_PAYMENTS_PORT=
# Root agent's own spending ceiling (HBAR), enforced by both grant_budget's
# hierarchy check and pay()'s budget check. Default 10.
FLOAT_ROOT_CEILING_HBAR=

# --- C5: Privy (Arc hot server wallet; the Arc key itself never lives here) ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=

# --- C6: Ledger Wallet CLI (treasury custody) ---
LEDGER_CLI_BIN=

# --- Rails, always on ---
# Spending ceilings, read by the policy layer.
FLOAT_CAP_DEFAULT_USD=50
FLOAT_CAP_HOT_BALANCE_USD=200
# 0/false is the ONLY way to go live (equivalently, FLOAT_LIVE=1 below).
# Unset or 1/true stubs every chain write and returns a synthetic
# dry_run:true tx id. Always defaults to stubbed — never inferred from
# which other env vars above happen to be set (#14). The server logs its
# effective mode loudly at startup either way.
DRY_RUN=1
# Alternate explicit live opt-in, read only when DRY_RUN is unset above.
FLOAT_LIVE=
